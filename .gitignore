# =============================================================================
# 🔒 .gitignore — Búnker DevSecOps Workshop
# ESTRICTO: Nunca subir secrets, llaves, o datos sensibles
# =============================================================================

# ── Secrets & Keys ───────────────────────────────────────────
.env
*.pem
*.key
*.p12
*.pfx
*.crt
!*.example
crypto/certs/*
crypto/keys/*

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.eggs/

# ── Reports (pueden contener info sensible) ──────────────────
reports/
*.sarif
bandit-report.json
semgrep-report.json
safety-report.json

# ── Terraform ────────────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfplan
crash.log

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Empaquetado del CLI ──────────────────────────────────────
build/
dist-cli/
*.egg-info/
